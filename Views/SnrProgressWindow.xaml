<Window x:Class="AstroDashboard.Views.SnrProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculate SNR Output"
        Height="500"
        Width="900"
        MinHeight="360"
        MinWidth="640"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="OutputTextBox"
                 Grid.Row="0"
                 IsReadOnly="True"
                 BorderBrush="{DynamicResource BorderBrush}"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ActionButton"
                    Width="100"
                    Height="30"
                    Content="Cancel"
                    Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource PrimaryButtonBackgroundBrush}"
                    Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                    Click="ActionButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
