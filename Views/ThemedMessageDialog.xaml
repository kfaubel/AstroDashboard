<Window x:Class="AstroDashboard.Views.ThemedMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        Height="420"
        Width="1180"
        MinHeight="260"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   FontSize="15"
                   FontWeight="SemiBold"/>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource WindowBackgroundBrush}"
                Visibility="{Binding ElementName=DetailsTextBox, Path=Visibility}">
            <TextBox x:Name="DetailsTextBox"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="10"
                     Visibility="Collapsed"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButtonControl"
                    Width="110"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    Background="{DynamicResource ReviewActionBackgroundBrush}"
                    BorderBrush="{DynamicResource ReviewActionBorderBrush}"
                    Foreground="{DynamicResource ReviewActionForegroundBrush}">
                Cancel
            </Button>
            <Button x:Name="OkButtonControl"
                    Width="110"
                    Height="32"
                    Click="OkButton_Click"
                    Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource PrimaryButtonBackgroundBrush}"
                    Foreground="{DynamicResource PrimaryButtonForegroundBrush}">
                OK
            </Button>
        </StackPanel>
    </Grid>
</Window>