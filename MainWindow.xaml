<Window x:Class="AstroDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstroDashboard"
        mc:Ignorable="d"
        Title="Astrophotography Dashboard" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:NodeTypeColorConverter x:Key="NodeTypeColorConverter"/>
        <local:NodeTypeToFontWeightConverter x:Key="NodeTypeToFontWeightConverter"/>
        <local:DepthToNumericColumnMarginConverter x:Key="DepthToNumericColumnMarginConverter"/>
        <local:NodeTypeToVisibilityConverter x:Key="NodeTypeToVisibilityConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="White">
            <Button Command="{Binding BrowseCommand}" Padding="10,5" Margin="0,0,5,0" Background="#0078D4" Foreground="White" FontWeight="Bold">
                Browse...
            </Button>
            <TextBox Text="{Binding SelectedPath, Mode=TwoWay}" Padding="5" Width="300" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Command="{Binding RefreshCommand}" Padding="10,5" Margin="0,0,10,0" Background="#0078D4" Foreground="White" FontWeight="Bold">
                Refresh
            </Button>
        </StackPanel>

        <!-- Main Content -->
        <Border Grid.Row="1" Margin="10" Background="White" BorderBrush="#D0D0D0" BorderThickness="1">
            <Grid TextElement.FontSize="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Projects Summary" Padding="10" FontWeight="Bold" Background="#E8E8E8"/>

                <Grid Grid.Row="1" Background="#F7F7F7" Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Margin="0,6,8,6" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Files" FontWeight="SemiBold" Margin="8,6,8,6" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="HH:MM" FontWeight="SemiBold" Margin="8,6,8,6" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Avg/Max RMS" FontWeight="SemiBold" Margin="8,6,8,6" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Avg/Max HFR" FontWeight="SemiBold" Margin="8,6,8,6" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Review Status" FontWeight="SemiBold" Margin="8,6,4,6" VerticalAlignment="Center"/>
                    <Border Grid.Column="0" BorderBrush="#DADADA" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="1" BorderBrush="#DADADA" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="2" BorderBrush="#DADADA" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="3" BorderBrush="#DADADA" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="4" BorderBrush="#DADADA" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="5" BorderBrush="#DADADA" BorderThickness="0,0,1,0"/>
                </Grid>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding VisibleTreeNodes}"
                         BorderThickness="0"
                         Background="White"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Margin="{Binding Depth, Converter={StaticResource DepthToNumericColumnMarginConverter}, ConverterParameter=Name}">
                                    <Button Width="18"
                                            Height="18"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            FontSize="12"
                                            Focusable="False"
                                            Content="▸"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleNodeExpansionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F3F3F3"/>
                                                <Setter Property="BorderBrush" Value="#CFCFCF"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                        <Setter Property="Content" Value=""/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Content" Value="▾"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E8E8E8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{Binding NodeType, Converter={StaticResource NodeTypeColorConverter}}"
                                               FontWeight="{Binding NodeType, Converter={StaticResource NodeTypeToFontWeightConverter}}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding FileCountText}" Margin="8,2,8,2" TextAlignment="Right" FontWeight="{Binding NodeType, Converter={StaticResource NodeTypeToFontWeightConverter}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding MinutesText}" Margin="8,2,8,2" TextAlignment="Right" FontWeight="{Binding NodeType, Converter={StaticResource NodeTypeToFontWeightConverter}}"/>
                                <TextBlock Grid.Column="3" Text="{Binding AverageRmsText}" Margin="8,2,8,2" TextAlignment="Right" FontWeight="{Binding NodeType, Converter={StaticResource NodeTypeToFontWeightConverter}}"/>
                                <TextBlock Grid.Column="4" Text="{Binding AverageHfrText}" Margin="8,2,8,2" TextAlignment="Right" FontWeight="{Binding NodeType, Converter={StaticResource NodeTypeToFontWeightConverter}}"/>
                                <StackPanel Grid.Column="5"
                                            Orientation="Horizontal"
                                            Margin="8,2,4,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding NodeType, Converter={StaticResource NodeTypeToVisibilityConverter}, ConverterParameter=Night}">
                                    <Button Width="26"
                                            Height="22"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="🔎"
                                            ToolTip="Open NIGHT folder in ApexAstro"
                                            Command="{Binding DataContext.OpenNightInApexAstroCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding AssociatedData}"/>
                                    <TextBlock Text="{Binding ReviewStatusText}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Reviewed}" Value="True">
                                                        <Setter Property="Foreground" Value="#1B7F2A"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="0" BorderBrush="#E7E7E7" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="1" BorderBrush="#E7E7E7" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="2" BorderBrush="#E7E7E7" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="3" BorderBrush="#E7E7E7" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="4" BorderBrush="#E7E7E7" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="5" BorderBrush="#E7E7E7" BorderThickness="0,0,1,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Margin="5"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
