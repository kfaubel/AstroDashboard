<Window x:Class="AstroDashboard.MainWindow"
    x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstroDashboard"
        mc:Ignorable="d"
        Title="Astrophotography Dashboard" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:NodeTypeToFontWeightConverter x:Key="NodeTypeToFontWeightConverter"/>
        <local:DepthToNumericColumnMarginConverter x:Key="DepthToNumericColumnMarginConverter"/>
        <local:NodeTypeToVisibilityConverter x:Key="NodeTypeToVisibilityConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="NodeNameTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NodeType}" Value="Telescope">
                    <Setter Property="Foreground" Value="{DynamicResource NodeTypeTelescopeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="Project">
                    <Setter Property="Foreground" Value="{DynamicResource NodeTypeProjectBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="Filter">
                    <Setter Property="Foreground" Value="{DynamicResource NodeTypeFilterBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="Night">
                    <Setter Property="Foreground" Value="{DynamicResource NodeTypeNightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="10" Background="{DynamicResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Command="{Binding BrowseCommand}" Padding="10,5" Margin="0,0,5,0" Background="{DynamicResource PrimaryButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}" FontWeight="Bold">
                    Browse...
                </Button>
                <TextBox Text="{Binding SelectedPath, Mode=TwoWay}"
                         Padding="5"
                         Width="300"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"
                         Background="{DynamicResource ComboBoxBackgroundBrush}"
                         BorderBrush="{DynamicResource ComboBoxBorderBrush}"
                         Foreground="{DynamicResource ComboBoxForegroundBrush}"/>
                <Button Command="{Binding RefreshCommand}" Padding="10,5" Margin="0,0,10,0" Background="{DynamicResource PrimaryButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}" FontWeight="Bold">
                    Refresh
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding CalculateSnrCommand}" Padding="10,5" Margin="0,0,10,0" Background="{DynamicResource PrimaryButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Right" Visibility="Collapsed">
                    Calculate SNR
                </Button>
                <CheckBox Content="Dark mode"
                          IsChecked="{Binding IsDarkModeEnabled, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Border Grid.Row="1" Margin="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid TextElement.FontSize="14" TextElement.Foreground="{DynamicResource PrimaryTextBrush}" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Projects Summary" Padding="10" FontWeight="Bold" Background="{DynamicResource SectionHeaderBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Grid Grid.Row="1" Background="{DynamicResource ColumnHeaderBrush}" Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="324" MinWidth="20" SharedSizeGroup="NameCol"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="78" MinWidth="16" SharedSizeGroup="FilesCol"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="82" MinWidth="16" SharedSizeGroup="TimeCol"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="106" MinWidth="16" SharedSizeGroup="RmsCol"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="106" MinWidth="16" SharedSizeGroup="HfrCol"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="210" MinWidth="24" SharedSizeGroup="StatusCol"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Margin="0,6,8,6" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Telescope, project, filter, or night name."/>
                    <TextBlock Grid.Column="2" Text="Files" FontWeight="SemiBold" Margin="8,6,8,6" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Number of FITS files included in this row."/>
                    <TextBlock Grid.Column="4" Text="Time" FontWeight="SemiBold" Margin="8,6,8,6" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Total exposure time in hours and minutes (HH:MM)."/>
                    <TextBlock Grid.Column="6" Text="Avg/Max RMS" FontWeight="SemiBold" Margin="8,6,8,6" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Average RMS and maximum RMS for the files in this row."/>
                    <TextBlock Grid.Column="8" Text="Avg/Max HFR" FontWeight="SemiBold" Margin="8,6,8,6" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Average HFR and maximum HFR for the files in this row."/>
                    <TextBlock Grid.Column="10" Text="Status" FontWeight="SemiBold" Margin="8,6,4,6" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Night review status and action to open the folder in ApexAstro."/>
                    <Border Grid.Column="0" BorderBrush="{DynamicResource ColumnDividerBrush}" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource ColumnDividerBrush}" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="4" BorderBrush="{DynamicResource ColumnDividerBrush}" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="6" BorderBrush="{DynamicResource ColumnDividerBrush}" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="8" BorderBrush="{DynamicResource ColumnDividerBrush}" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="10" BorderBrush="{DynamicResource ColumnDividerBrush}" BorderThickness="0,0,1,0"/>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ShowsPreview="True"/>
                    <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ShowsPreview="True"/>
                    <GridSplitter Grid.Column="5" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ShowsPreview="True"/>
                    <GridSplitter Grid.Column="7" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ShowsPreview="True"/>
                    <GridSplitter Grid.Column="9" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ShowsPreview="True"/>
                </Grid>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding VisibleTreeNodes}"
                         BorderThickness="0"
                         Background="{DynamicResource SurfaceBrush}"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="20" SharedSizeGroup="NameCol"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto" MinWidth="16" SharedSizeGroup="FilesCol"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto" MinWidth="16" SharedSizeGroup="TimeCol"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto" MinWidth="16" SharedSizeGroup="RmsCol"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto" MinWidth="16" SharedSizeGroup="HfrCol"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto" MinWidth="24" SharedSizeGroup="StatusCol"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Margin="{Binding Depth, Converter={StaticResource DepthToNumericColumnMarginConverter}, ConverterParameter=Name}">
                                        <Button Width="22"
                                            Height="22"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Focusable="False"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleNodeExpansionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="▶"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Content" Value="▼"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TreeGlyphHoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource NodeNameTextStyle}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding FileCountText}" Margin="8,2,8,2" TextAlignment="Right" FontWeight="{Binding NodeType, Converter={StaticResource NodeTypeToFontWeightConverter}}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Grid.Column="4" Text="{Binding MinutesText}" Margin="8,2,8,2" TextAlignment="Right" FontWeight="{Binding NodeType, Converter={StaticResource NodeTypeToFontWeightConverter}}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Grid.Column="6" Text="{Binding AverageRmsText}" Margin="8,2,8,2" TextAlignment="Right" FontWeight="{Binding NodeType, Converter={StaticResource NodeTypeToFontWeightConverter}}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Grid.Column="8" Text="{Binding AverageHfrText}" Margin="8,2,8,2" TextAlignment="Right" FontWeight="{Binding NodeType, Converter={StaticResource NodeTypeToFontWeightConverter}}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <StackPanel Grid.Column="10"
                                            Orientation="Horizontal"
                                            Margin="8,2,4,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding NodeType, Converter={StaticResource NodeTypeToVisibilityConverter}, ConverterParameter=Project|Night}">
                                    <TextBlock Text="{Binding ReviewStatusText}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding NodeType, Converter={StaticResource NodeTypeToVisibilityConverter}, ConverterParameter=Project}"
                                               Foreground="{DynamicResource ReviewStatusReviewedBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ReviewStatusText}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding NodeType, Converter={StaticResource NodeTypeToVisibilityConverter}, ConverterParameter=Night}"
                                               ToolTip="Right-click to toggle review status">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Toggle Reviewed"
                                                          Command="{Binding DataContext.ToggleNightReviewCommand, Source={x:Reference RootWindow}}"
                                                          CommandParameter="{Binding AssociatedData}"/>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ReviewStatusPendingBrush}"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Reviewed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ReviewStatusReviewedBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Margin="8,0,0,0"
                                            Padding="8,1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource ReviewActionBackgroundBrush}"
                                            BorderBrush="{DynamicResource ReviewActionBorderBrush}"
                                            Foreground="{DynamicResource ReviewActionForegroundBrush}"
                                            FontWeight="SemiBold"
                                            Content="Open"
                                            ToolTip="Open folder in ApexAstro"
                                            Command="{Binding DataContext.OpenNightInApexAstroCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding AssociatedData}"/>
                                </StackPanel>
                                <Border Grid.Column="0" BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="4" BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="6" BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="8" BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="10" BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,0,1,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Margin="5" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
