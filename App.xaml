<Application x:Class="AstroDashboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ColumnDividerBrush" Color="#D9E1EC"/>
    <SolidColorBrush x:Key="RowDividerBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TreeGlyphHoverBrush" Color="#0B1220"/>

    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#F8FAFC"/>

    <SolidColorBrush x:Key="ReviewActionBackgroundBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ReviewActionBorderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ReviewActionForegroundBrush" Color="#0F172A"/>

    <SolidColorBrush x:Key="ReviewStatusPendingBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="ReviewStatusReviewedBrush" Color="#166534"/>

    <SolidColorBrush x:Key="NodeTypeTelescopeBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="NodeTypeProjectBrush" Color="#047857"/>
    <SolidColorBrush x:Key="NodeTypeFilterBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="NodeTypeNightBrush" Color="#1E293B"/>

    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ComboBoxForegroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#BFDBFE"/>
    </Application.Resources>
</Application>
